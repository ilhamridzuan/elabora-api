# ==============================================================================
# eLabora API - Environment Variables Example
# ==============================================================================
# Salin file ini ke `.env` lalu isi nilainya sesuai environment lokal/produksi.
# JANGAN commit file `.env` (sudah di-ignore di .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Port HTTP server. Default 3000 jika tidak di-set.
PORT=3000

# Mode environment Node.js. Gunakan "development" agar stack trace error
# ditampilkan di response. Selain itu (mis. "production") stack trace disembunyikan.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=elabora_db

# ------------------------------------------------------------------------------
# Authentication / Security
# ------------------------------------------------------------------------------
# Secret untuk signing JWT. WAJIB diisi dan minimal 32 karakter
# (server akan exit jika tidak memenuhi).
# Generate contoh: `openssl rand -hex 32`
JWT_SECRET=replace_with_random_string_min_32_chars

# Masa berlaku token JWT (mis. "1d", "12h", "7d").
JWT_EXPIRES=1d

# Cost factor bcrypt untuk hashing password (10-12 disarankan).
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Daftar origin yang diizinkan, dipisah koma. Jika kosong, default ke
# http://localhost:3000, http://localhost:5173, http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (Push Notification) - Opsional
# ------------------------------------------------------------------------------
# Service account JSON Firebase yang sudah di-encode base64.
# Contoh generate: `base64 -w0 service-account.json`
# Jika kosong, fitur push notification dinonaktifkan.
FIREBASE_SERVICE_ACCOUNT_B64=

# Nama channel notifikasi Android. Default "antrian".
FCM_ANDROID_CHANNEL_ID=antrian

# ------------------------------------------------------------------------------
# Azure Blob Storage
# ------------------------------------------------------------------------------
# Nama Storage Account Azure (lowercase, 3-24 char, unik global).
AZURE_STORAGE_ACCOUNT_NAME=elaborastorage # required in prod (Managed Identity)

# Connection string Storage Account untuk dev lokal / Azurite emulator.
# Di production WAJIB kosong agar Managed Identity (DefaultAzureCredential) aktif.
AZURE_STORAGE_CONNECTION_STRING= # local dev only; empty in prod

# Nama container blob untuk surat rujukan dan hasil pemeriksaan.
AZURE_BLOB_CONTAINER_REFERRALS=surat-rujukan
AZURE_BLOB_CONTAINER_EXAMS=exam-results

# Masa berlaku SAS URL (menit). Di-clamp ke rentang [1, 15]; fallback 10 jika invalid.
AZURE_BLOB_SAS_EXPIRY_MINUTES=10 # valid 1-15 minutes
